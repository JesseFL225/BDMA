{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.local/bin/graphify\" ]; then \"$HOME/.local/bin/graphify\" hook-guard search; fi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.local/bin/graphify\" ]; then \"$HOME/.local/bin/graphify\" hook-guard read; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.local/bin/graphify\" ]; then \"$HOME/.local/bin/graphify\" hook-guard compact; fi",
            "timeout": 10
          }
        ]
      }
    ]
  }
}